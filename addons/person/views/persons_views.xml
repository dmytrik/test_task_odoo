<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_persons_tree" model="ir.ui.view">
        <field name="name">person.person.tree</field>
        <field name="model">person.person</field>
        <field name="arch" type="xml">
            <tree>
                <field name="full_name"/>
                <field name="birthday"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_persons_form" model="ir.ui.view">
        <field name="name">person.person.form</field>
        <field name="model">person.person</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="first_name"/>
                        <field name="last_name"/>
                        <field name="full_name" readonly="1"/>
                    </group>
                    <group>
                        <field name="birthday"/>
                        <field name="age" readonly="1"/>
                        <field name="sex"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_persons" model="ir.actions.act_window">
        <field name="name">Person</field>
        <field name="res_model">person.person</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_persons"
              name="Persons"
              action="action_persons"
    />
</odoo>
